{
  "author": {
    "email": "netowls-studio@outlook.com",
    "name": "Yucai Wang"
  },
  "bugs": {
    "url": "https://github.com/source-club/get-started/issues"
  },
  "description": "Git code repository template!",
  "devDependencies": {
    "@types/commit-and-tag-version": "^7.1.3",
    "commit-and-tag-version": "^12.6.1",
    "npkill": "0.12.2"
  },
  "homepage": "https://github.com/source-club/get-started#readme",
  "keywords": [
    "get-started",
    "source-club",
    "git"
  ],
  "license": "MIT",
  "name": "@source-club/get-started",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/source-club/get-started.git"
  },
  "scripts": {
    "dotnet:release": "dotnet tool restore && dotnet tool run nbgv prepare-release --project ./",
    "git:push": "git push --tags && git push --all",
    "pnpm:clean": "npkill -d ./",
    "pnpm:restore": "pnpm install --filter ./src/**",
    "pnpm:restore:root": "pnpm install",
    "pnpm:update": "pnpm update --filter ./src/** -i",
    "pnpm:update:root": "pnpm update -i",
    "pre-release:major": "commit-and-tag-version -r major -p Debug -i CHANGELOG.md",
    "pre-release:major-dryrun": "commit-and-tag-version -r major -p Debug -i CHANGELOG.md --dry-run",
    "pre-release:minor": "commit-and-tag-version -r minor -p Debug -i CHANGELOG.md",
    "pre-release:minor-dryrun": "commit-and-tag-version -r minor -p Debug -i CHANGELOG.md --dry-run",
    "pre-release:patch": "commit-and-tag-version -r patch -p Debug -i CHANGELOG.md",
    "pre-release:patch-dryrun": "commit-and-tag-version -r patch -p Debug -i CHANGELOG.md --dry-run",
    "release:major": "commit-and-tag-version -r major -i CHANGELOG.md",
    "release:major-dryrun": "commit-and-tag-version -r major -i CHANGELOG.md --dry-run",
    "release:minor": "commit-and-tag-version -r minor -i CHANGELOG.md",
    "release:minor-dryrun": "commit-and-tag-version -r minor -i CHANGELOG.md --dry-run",
    "release:patch": "commit-and-tag-version -r patch -i CHANGELOG.md",
    "release:patch-dryrun": "commit-and-tag-version -r patch -i CHANGELOG.md --dry-run",
    "workspace:version:major": "pnpm run --filter ./src/** version:major",
    "workspace:version:minor": "pnpm run --filter ./src/** version:minor",
    "workspace:version:patch": "pnpm run --filter ./src/** version:patch",
    "workspace:version:premajor": "pnpm run --filter ./src/** version:premajor",
    "workspace:version:preminor": "pnpm run --filter ./src/** version:preminor",
    "workspace:version:prepatch": "pnpm run --filter ./src/** version:prepatch",
    "workspace:version:prerelease": "pnpm run --filter ./src/** version:prerelease",
    "version:major": "pnpm version major --no-git-tag-version",
    "version:minor": "pnpm version minor --no-git-tag-version",
    "version:patch": "pnpm version patch --no-git-tag-version",
    "version:premajor": "pnpm version premajor --preid Debug --no-git-tag-version",
    "version:preminor": "pnpm version preminor --preid Debug --no-git-tag-version",
    "version:prepatch": "pnpm version prepatch --preid Debug --no-git-tag-version",
    "version:prerelease": "pnpm version prerelease --preid Debug --no-git-tag-version"
  },
  "version": "1.0.0"
}
