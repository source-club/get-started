{
  "name": "@source-club/get-started",
  "version": "1.0.0-Debug.0",
  "description": "Git code repository template!",
  "keywords": [
    "get-started",
    "source-club",
    "git"
  ],
  "homepage": "https://github.com/source-club/get-started#readme",
  "bugs": {
    "url": "https://github.com/source-club/get-started/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/source-club/get-started.git"
  },
  "license": "MIT",
  "author": {
    "name": "Yucai Wang",
    "email": "netowls-studio@outlook.com"
  },
  "scripts": {
    "dotnet:release": "dotnet tool restore && dotnet tool run nbgv prepare-release --project ./",
    "git:push": "git push --tags && git push --all",
    "pnpm:clean": "npkill -d ./",
    "pnpm:restore:root": "pnpm install",
    "pnpm:restore": "pnpm install --filter ./src/**",
    "pnpm:update:root": "pnpm update -i",
    "pnpm:update": "pnpm update --filter ./src/** -i",
    "pre-release:major-dryrun": "standard-version -r major -p Debug -i CHANGELOG.md --dry-run",
    "pre-release:major": "standard-version -r major -p Debug -i CHANGELOG.md",
    "pre-release:minor-dryrun": "standard-version -r minor -p Debug -i CHANGELOG.md --dry-run",
    "pre-release:minor": "standard-version -r minor -p Debug -i CHANGELOG.md",
    "pre-release:patch-dryrun": "standard-version -r patch -p Debug -i CHANGELOG.md --dry-run",
    "pre-release:patch": "standard-version -r patch -p Debug -i CHANGELOG.md",
    "release:major-dryrun": "standard-version -r major -i CHANGELOG.md --dry-run",
    "release:major": "standard-version -r major -i CHANGELOG.md",
    "release:minor-dryrun": "standard-version -r minor -i CHANGELOG.md --dry-run",
    "release:minor": "standard-version -r minor -i CHANGELOG.md",
    "release:patch-dryrun": "standard-version -r patch -i CHANGELOG.md --dry-run",
    "release:patch": "standard-version -r patch -i CHANGELOG.md"
  },
  "devDependencies": {
    "@types/standard-version": "^7.1.3",
    "npkill": "0.12.2",
    "standard-version": "9.5.0"
  }
}
