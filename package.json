{
  "author": {
    "email": "netowls-studio@outlook.com",
    "name": "Yucai Wang"
  },
  "bugs": {
    "url": "https://github.com/source-club/get-started/issues"
  },
  "config": {
    "commitizen": {
      "issuePrefixes": [
        {
          "name": "进行中",
          "value": "WIP"
        },
        {
          "name": "完成",
          "value": "Done"
        },
        {
          "name": "关闭",
          "value": "Closes"
        },
        {
          "name": "重新打开",
          "value": "Re-open"
        }
      ],
      "scopes": []
    }
  },
  "description": "Git code repository template!",
  "devDependencies": {
    "czg": "^1.13.2",
    "devrun": "^0.1.1",
    "npkill": "^0.12.2"
  },
  "homepage": "https://github.com/source-club/get-started#readme",
  "keywords": [
    "get-started",
    "source-club",
    "git"
  ],
  "license": "MIT",
  "name": "@source-club/get-started",
  "packageManager": "pnpm@12.3.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/source-club/get-started.git"
  },
  "scripts": {
    "dotnet:release": "dotnet tool restore && dotnet tool run nbgv prepare-release --project ./",
    "dotnet:tool:update": "dotnet tool update --all --local",
    "git:commit:cz": "czg",
    "git:commit:cz:break": "czg break",
    "git:commit:cz:checkbox": "czg checkbox",
    "git:push": "git push --tags && git push --all",
    "npm:packages:clear": "npkill -d ./",
    "pnpm:restore": "pnpm install --filter ./src/**",
    "pnpm:restore:root": "pnpm install",
    "pnpm:update": "pnpm update --filter ./src/** -i",
    "pnpm:update:root": "pnpm update -i"
  },
  "version": "3.0.0"
}
